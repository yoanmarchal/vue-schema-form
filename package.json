{
  "name": "vite-form",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-driven, fully typed forms for Vue 3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoanmarchal/vite-form.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:playground": "vite build playground",
    "typecheck": "vue-tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "publint": "publint"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
